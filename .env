# Puerto en el que se ejecutará el servidor local de Express (por defecto el 3000)
PORT=3000

# Token de verificación secreto que tú inventas. 
# Debe coincidir exactamente con el que escribas en el panel de desarrolladores de Meta 
# al configurar el Webhook para que Meta compruebe que tu servidor es legítimo.
VERIFY_TOKEN=j804_ht

# Token de acceso permanente o temporal que te proporciona Meta Developers 
# en la sección de WhatsApp de tu app. 
# Permite que tu código (Axios) tenga autorización para enviar mensajes a los usuarios.
WHATSAPP_TOKEN=
# El ID del número de teléfono de WhatsApp Business proporcionado por la API de Meta. 
# Indica desde cuál número de la plataforma se enviarán las respuestas automatizadas.
PHONE_NUMBER_ID=
